# Database
# Use your local PostgreSQL credentials (DEV) or configure via Vercel UI (PRODUCTION)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/asa_db"

# NextAuth
# Generate new secret: openssl rand -base64 32
# NEVER use placeholder values in production
NEXTAUTH_SECRET="MUST_GENERATE_NEW_SECRET_WITH_OPENSSL_IN_PRODUCTION"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="MUST_GENERATE_NEW_SECRET_WITH_OPENSSL_IN_PRODUCTION"
